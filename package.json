    "src/",
    "docs/images/",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/server.js",
    "test": "node test/smoke.js",
    "check": "node test/syntax-check.js",
    "demo": "node test/demo-art.js",
    "demo:slime": "node test/slime.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "aseprite",
    "pixel-art",
    "sprite",
    "animation",
    "gamedev",
    "ai-agent",
    "pixel-editor"
  ],
