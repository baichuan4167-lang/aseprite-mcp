{
  "name": "aseprite-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol server that lets an AI agent draw pixel art and animations in Aseprite — sprites, layers, frames, tags, palettes, and GIF/sprite-sheet exports — by driving Aseprite headlessly.",
  "main": "src/server.js",
  "bin": {
    "aseprite-mcp": "src/server.js"
  },
